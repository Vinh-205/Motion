NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://motion-api.vihx.online
DATABASE_PATH=./data/motion.sqlite
# Render Free: required; use a separate Neon project, never a classroom database.
DATABASE_URL=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Motion <no-reply@motion-mail.vihx.online>
# Generate separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Motion <no-reply@vihx.online>
# One-time bootstrap only; remove after creating admin. No default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Motion Admin
# Render Free has no shell: optional FIRST admin bootstrap, remove after first deploy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
