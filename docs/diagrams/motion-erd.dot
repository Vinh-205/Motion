digraph MotionERD {
  graph [rankdir=TB, bgcolor="#f6f8fc", pad="0.55", nodesep="0.75", ranksep="0.7", splines=polyline, fontname="Segoe UI", label="MOTION  |  MÔ HÌNH DỮ LIỆU LOGIC\nAndroid SharedPreferences + JSON — không phải lược đồ SQL", labelloc=t, fontsize=26, fontcolor="#172b45"];
  node [shape=plain, fontname="Segoe UI", fontsize=16];
  edge [fontname="Segoe UI", fontsize=13, color="#657b94", fontcolor="#354e6e", penwidth=1.6, arrowsize=0.9];

  CONFIG [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="13" COLOR="#c9d5e4" BGCOLOR="white">
      <TR><TD BGCOLOR="#203a56" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="21"><B>CẤU HÌNH ỨNG DỤNG</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>Một bộ cấu hình cục bộ / bản cài</I></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">ownerName: tên người dùng<BR ALIGN="LEFT"/>enabled: bật SOS qua SIM<BR ALIGN="LEFT"/>monitoring: giám sát cảm biến<BR ALIGN="LEFT"/>countdownSeconds: 15–30 giây<BR ALIGN="LEFT"/>sensitivity: low / medium / high<BR ALIGN="LEFT"/>autoCallEnabled: tùy chọn gọi<BR ALIGN="LEFT"/>alertSoundUri: âm riêng, có thể trống<BR ALIGN="LEFT"/>appearance: light / dark</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#edf3fa"><FONT POINT-SIZE="13">Không có tài khoản hoặc userId từ máy chủ</FONT></TD></TR>
    </TABLE>
  >];
  CONTACT [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="13" COLOR="#c9d5e4" BGCOLOR="white">
      <TR><TD BGCOLOR="#417538" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="21"><B>LIÊN HỆ KHẨN CẤP</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>id: mã liên hệ duy nhất</B><BR ALIGN="LEFT"/>name: họ tên<BR ALIGN="LEFT"/>phone: số điện thoại đã chuẩn hóa</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eff6eb"><FONT POINT-SIZE="13">Mảng contacts; tối đa 10 người<BR ALIGN="LEFT"/>Người đầu danh sách là số ưu tiên gọi<BR ALIGN="LEFT"/>Không có cột isPriority riêng</FONT></TD></TR>
    </TABLE>
  >];
  EVENT [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="13" COLOR="#c9d5e4" BGCOLOR="white">
      <TR><TD BGCOLOR="#365d91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="21"><B>SỰ KIỆN / LỊCH SỬ</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>id: mã sự kiện duy nhất</B><BR ALIGN="LEFT"/>at: thời điểm<BR ALIGN="LEFT"/>source: sensor / manual<BR ALIGN="LEFT"/>outcome: safe / sos / cancelled<BR ALIGN="LEFT"/>reason, sensitivity, countdownSeconds<BR ALIGN="LEFT"/>smsStatus, detail: kết quả SMS tổng</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Vị trí tùy chọn — nằm trong sự kiện</B><BR ALIGN="LEFT"/>latitude, longitude<BR ALIGN="LEFT"/>locationAccuracy, locationAt</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Cuộc gọi — nằm trong sự kiện</B><BR ALIGN="LEFT"/>callPhone, callStatus, callDetail</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#edf3fa"><FONT POINT-SIZE="13">Mảng events; giữ tối đa 200 sự kiện<BR ALIGN="LEFT"/>Không lưu toàn bộ luồng mẫu cảm biến</FONT></TD></TR>
    </TABLE>
  >];
  RECIPIENT [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="13" COLOR="#c9d5e4" BGCOLOR="white">
      <TR><TD BGCOLOR="#8b5c28" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="21"><B>NGƯỜI NHẬN TẠI SỰ KIỆN</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>id: eventId:r + thứ tự người nhận</B><BR ALIGN="LEFT"/>name, phone: bản sao tại lúc kích hoạt<BR ALIGN="LEFT"/>smsStatus: kết quả riêng của người này<BR ALIGN="LEFT"/>detail: thông tin gửi hoặc lỗi</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#fff4e7"><FONT POINT-SIZE="13">recipients nằm trong JSON của sự kiện<BR ALIGN="LEFT"/>Liên kết với sự kiện qua cấu trúc lồng nhau<BR ALIGN="LEFT"/>Không lưu contactId làm khóa ngoại</FONT></TD></TR>
    </TABLE>
  >];

  {rank=same; CONFIG; CONTACT;}
  {rank=same; EVENT; RECIPIENT;}
  CONFIG -> CONTACT [label="1 → 0..10\nliên hệ", style=dashed, arrowhead=none];
  CONFIG -> EVENT [label="1 → 0..200\nsự kiện", style=dashed, arrowhead=none];
  EVENT -> RECIPIENT [label="1 → 0..10\nbản sao", arrowhead=crow, arrowtail=tee, dir=both];
  CONTACT -> RECIPIENT [label="Chụp tên / số khi kích hoạt\nKhông phải quan hệ FK", style=dotted, color="#a27c43", arrowhead=normal];

  LEGEND [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="12" BGCOLOR="#e8eef6">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>CÁCH ĐỌC</B>  |  Các hộp là nhóm dữ liệu logic, không phải bảng SQL.</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">Sửa / xóa liên hệ hiện tại không sửa bản sao người nhận trong lịch sử.<BR ALIGN="LEFT"/>Vị trí và trạng thái gọi là trường của sự kiện, không có bảng riêng.<BR ALIGN="LEFT"/>Claim chống gửi / gọi trùng và countdown<BR ALIGN="LEFT"/>lưu bằng khóa SharedPreferences bổ trợ.</TD></TR>
    </TABLE>
  >];
  EVENT -> LEGEND [style=invis];
  RECIPIENT -> LEGEND [style=invis];
}
